/wordpress/
/.tools/

# Local secrets and logs
.env.local
*.log

# Never commit database dumps or archives
*.sql
*.sql.gz
*.zip
*.tgz

# Dependencies (if a build step is ever added)
node_modules/
vendor/

# Server-only deploy settings
bin/.deploy.env

# macOS Finder files
.DS_Store
