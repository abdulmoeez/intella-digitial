   "name": "intella/custom-section",
   "attrs": {
    "label": "Digital marketing that brings in customers",
    "html": "<section class=\"page-hero page-hero--center hero-wide\" aria-labelledby=\"page-title\">\n\t\t<div class=\"container\">\n\t\t\t<nav class=\"breadcrumb\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/\">Home</a></li><li><a href=\"/services/\">Services</a></li><li aria-current=\"page\">Digital Marketing</li></ol></nav>\n\t\t\t<h1 class=\"page-hero__title\" id=\"page-title\">Digital marketing that <span class=\"accent\">brings in customers</span></h1>\n\t\t\t<p class=\"page-hero__lead\">Search, ads, social, email and conversion work planned together, so every channel pushes the same goal. One team, one plan, one report.</p>\n\t\t\t<div class=\"hero__actions hero__actions--center\">\n\t\t\t\t<a class=\"button button--primary button--lg\" href=\"#proposal\">Request a proposal <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t<a class=\"button button--outline button--lg\" href=\"#services\">Explore our services</a>\n\t\t\t</div>\n\t\t\t<ul class=\"chip-row chip-row--plain\" role=\"list\"><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Strategy before tactics</span></li><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Every channel, one team</span></li><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Clear monthly reporting</span></li></ul>\n\t\t\t<div class=\"hero-wide__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Marketing plan · Budget by channel</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-bars\"><div class=\"mock-bar mock-bar--you\"><span>SEO and content</span><em><i style=\"width:100%\"></i></em><span class=\"num\">35%</span></div><div class=\"mock-bar\"><span>Google Ads</span><em><i style=\"width:80%\"></i></em><span class=\"num\">28%</span></div><div class=\"mock-bar\"><span>LinkedIn Ads</span><em><i style=\"width:46%\"></i></em><span class=\"num\">16%</span></div><div class=\"mock-bar\"><span>Email and automation</span><em><i style=\"width:31%\"></i></em><span class=\"num\">11%</span></div><div class=\"mock-bar\"><span>Website and CRO</span><em><i style=\"width:29%\"></i></em><span class=\"num\">10%</span></div></div><div class=\"mock-stats mock-stats--3\"><div class=\"mock-stat mock-stat--violet\"><div class=\"mock-stat__label\">Monthly budget</div><div class=\"mock-stat__value\">$18K</div></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Target leads</div><div class=\"mock-stat__value\">220</div></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Target cost / lead</div><div class=\"mock-stat__value\">$82</div></div></div></div>\n</figure></div>\n\t\t</div>\n\t</section>",
    "css": "digital-marketing",
    "modules": []
   }
