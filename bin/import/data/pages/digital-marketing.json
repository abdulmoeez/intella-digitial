   "name": "intella/custom-section",
   "attrs": {
    "label": "Every channel, one plan",
    "html": "<section class=\"section section--white\" id=\"services\" aria-labelledby=\"h-1\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-1\">Every channel, <span class=\"accent\">one plan</span></h2>\n\t\t\t\t<p class=\"section-lead\">Pick one service or let us combine them. Each group links to the full service pages.</p>\n\t\t\t</div>\n\t\t\t<ul class=\"hub-cols\" role=\"list\">\n\t\t\t\t<li class=\"hub-col\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-search\"/></svg></span>\n\t\t\t\t\t<h3 class=\"hub-col__title\">SEO and Content</h3>\n\t\t\t\t\t<p class=\"hub-col__text\">Get found on Google and in AI answers, with content people want to read.</p>\n\t\t\t\t\t<ul class=\"hub-col__links\" role=\"list\"><li><a href=\"/services/digital-marketing/seo/\">SEO</a></li><li><a href=\"/services/digital-marketing/geo/\">GEO / AI search</a></li><li><a href=\"/services/digital-marketing/content-marketing/\">Content Marketing</a></li><li><a href=\"/services/digital-marketing/local-seo/\">Local SEO</a></li><li><a href=\"/services/digital-marketing/ecommerce-seo/\">eCommerce SEO</a></li><li><a href=\"/services/digital-marketing/link-building/\">Link Building</a></li></ul>\n\t\t\t\t\t<a class=\"text-link\" href=\"/services/#seo\">See all <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"hub-col\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-target\"/></svg></span>\n\t\t\t\t\t<h3 class=\"hub-col__title\">Performance Marketing</h3>\n\t\t\t\t\t<p class=\"hub-col__text\">Paid search and social campaigns built around cost per lead, not clicks.</p>\n\t\t\t\t\t<ul class=\"hub-col__links\" role=\"list\"><li><a href=\"/services/digital-marketing/performance-marketing/google-ads/\">Google Ads</a></li><li><a href=\"/services/digital-marketing/performance-marketing/google-shopping-ads/\">Google Shopping Ads</a></li><li><a href=\"/services/digital-marketing/performance-marketing/youtube-ads/\">YouTube Ads</a></li><li><a href=\"/services/digital-marketing/performance-marketing/linkedin-ads/\">LinkedIn Ads</a></li><li><a href=\"/services/digital-marketing/performance-marketing/facebook-ads/\">Meta Ads</a></li><li><a href=\"/services/digital-marketing/performance-marketing/instagram-ads/\">Instagram Ads</a></li></ul>\n\t\t\t\t\t<a class=\"text-link\" href=\"/services/digital-marketing/performance-marketing/\">See all <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"hub-col\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-share\"/></svg></span>\n\t\t\t\t\t<h3 class=\"hub-col__title\">Social Media</h3>\n\t\t\t\t\t<p class=\"hub-col__text\">Consistent, on-brand social media that builds trust and starts conversations.</p>\n\t\t\t\t\t<ul class=\"hub-col__links\" role=\"list\"><li><a href=\"/social-media-management/\">Social Media Management</a></li><li><a href=\"/social-content-creation/\">Content Creation</a></li><li><a href=\"/linkedin-b2b/\">LinkedIn for B2B</a></li><li><a href=\"/services/digital-marketing/social-media/influencer-marketing/\">Influencer Marketing</a></li></ul>\n\t\t\t\t\t<a class=\"text-link\" href=\"/services/#social\">See all <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"hub-col\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-mail\"/></svg></span>\n\t\t\t\t\t<h3 class=\"hub-col__title\">Email & Automation</h3>\n\t\t\t\t\t<p class=\"hub-col__text\">Emails and automations that turn leads into customers while you sleep.</p>\n\t\t\t\t\t<ul class=\"hub-col__links\" role=\"list\"><li><a href=\"/services/digital-marketing/email-marketing/\">Email Marketing</a></li><li><a href=\"/services/digital-marketing/marketing-automation/\">Marketing Automation</a></li><li><a href=\"/services/digital-marketing/crm-setup/\">CRM Setup</a></li><li><a href=\"/services/digital-marketing/lead-nurturing/\">Lead Nurturing</a></li></ul>\n\t\t\t\t\t<a class=\"text-link\" href=\"/services/#email\">See all <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"hub-col\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-chart\"/></svg></span>\n\t\t\t\t\t<h3 class=\"hub-col__title\">CRO & Analytics</h3>\n\t\t\t\t\t<p class=\"hub-col__text\">Tracking, testing and reports that show what works and what to fix.</p>\n\t\t\t\t\t<ul class=\"hub-col__links\" role=\"list\"><li><a href=\"/services/digital-marketing/conversion-rate-optimisation/\">Conversion Rate Optimisation</a></li><li><a href=\"/ga4-tracking-setup/\">GA4 and Tracking Setup</a></li><li><a href=\"/services/digital-marketing/reporting-dashboards/\">Reporting Dashboards</a></li><li><a href=\"/services/digital-marketing/ab-testing/\">A/B Testing</a></li></ul>\n\t\t\t\t\t<a class=\"text-link\" href=\"/services/#cro\">See all <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t</section>",
    "css": "digital-marketing",
    "modules": []
   }
