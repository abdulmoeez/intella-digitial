  {
   "name": "intella/faq",
   "attrs": {
    "background": "white",
    "anchor": "",
    "title": "Digital marketing questions, <em>answered</em>",
    "lead": "Can’t find your answer? Ask us on a free 30-minute call.",
    "buttonText": "Contact us",
    "buttonUrl": "/contact/",
    "items": [
     {
      "question": "Which channel should we start with?",
      "answer": "It depends on your goals, budget and how people buy from you. We recommend a starting mix after a free call and a quick look at your numbers."
     },
     {
      "question": "Do we need to use every service?",
      "answer": "No. Many clients start with one or two channels and add more once those are working."
     },
     {
      "question": "How soon will we see results?",
      "answer": "Paid ads can bring leads within weeks. SEO and content usually take a few months to build. We set realistic targets for each."
     },
     {
      "question": "How do you report?",
      "answer": "You get a live dashboard and a monthly report that explains what happened, why, and what we’ll do next."
     }
    ],
    "buttonStyle": "outline"
   }
  },
