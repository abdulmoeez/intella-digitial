  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "Proven growth stories",
    "html": "<section class=\"section section--cream\" aria-labelledby=\"h-5\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--split\">\n\t\t\t\t<div><h2 class=\"section-title\" id=\"h-5\">Proven <span class=\"accent\">growth stories</span></h2></div>\n\t\t\t\t<a class=\"button button--outline\" href=\"/case-studies/\">All case studies</a>\n\t\t\t</div>\n\t\t\t<div class=\"teasers\">\n\t\t\t\t<article class=\"teaser teaser--dark\">\n\t\t\t\t\t<span class=\"card-tag\">Case study · Web platform</span>\n\t\t\t\t\t<h3 class=\"teaser__title\">Cupello</h3>\n\t\t\t\t\t<p>Modernising football coaching technology with a faster, more usable platform.</p>\n\t\t\t\t\t<blockquote class=\"teaser__quote\">“They built a modern, high-performing platform that has helped us better engage our customers.”<span>David Clarke, CEO &amp; Founder</span></blockquote>\n\t\t\t\t\t<a class=\"text-link\" href=\"/case-studies/cupello-modernizing-football-coaching-technology/\">Read the case study <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</article>\n\t\t\t\t<article class=\"teaser\">\n\t\t\t\t\t<span class=\"card-tag\">Case study · eCommerce</span>\n\t\t\t\t\t<h3 class=\"teaser__title\">The Other Glasses</h3>\n\t\t\t\t\t<p>A luxury eyewear e-commerce experience, designed and built end to end.</p>\n\t\t\t\t\t<blockquote class=\"teaser__quote\">“A website that perfectly captured our brand and vision.”<span>Andra-Simina Mocanu, CEO &amp; Founder</span></blockquote>\n\t\t\t\t\t<a class=\"text-link\" href=\"/case-studies/the-other-glasses-luxury-eyewear-e-commerce-experience-intella-digital/\">Read the case study <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</article>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "digital-marketing",
    "modules": []
   }
