  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "Strategy, not just tactics",
    "html": "<section class=\"section section--white\" aria-labelledby=\"h-4\">\n\t\t<div class=\"container why\">\n\t\t\t<div>\n\t\t\t\t<h2 class=\"section-title\" id=\"h-4\">Strategy, not just <span class=\"accent\">tactics</span></h2>\n\t\t\t\t<p class=\"section-lead\">You get senior people who plan, build and report, and a team that can fix your website too.</p>\n\t\t\t\t<div class=\"why__actions\"><a class=\"button button--primary button--lg\" href=\"#proposal\">Request a proposal <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a></div>\n\t\t\t</div>\n\t\t\t<ul class=\"bento\" role=\"list\">\n\t\t\t\t<li class=\"bento__card bento__card--dark\">\n\t\t\t\t\t<span class=\"icon-tile icon-tile--dark\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-layers\"/></svg></span>\n\t\t\t\t\t<h3 class=\"bento__title\">Full-service team</h3>\n\t\t\t\t\t<p>SEO, ads, social, email, design and development under one roof.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"bento__card\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-chart\"/></svg></span>\n\t\t\t\t\t<h3 class=\"bento__title\">Transparent reporting</h3>\n\t\t\t\t\t<p>A live dashboard and a plain-English monthly report.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"bento__card\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-target\"/></svg></span>\n\t\t\t\t\t<h3 class=\"bento__title\">Channel specialists</h3>\n\t\t\t\t\t<p>Each channel is run by someone who does it every day.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"bento__card bento__card--dark\">\n\t\t\t\t\t<span class=\"icon-tile icon-tile--dark\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-sparkle\"/></svg></span>\n\t\t\t\t\t<h3 class=\"bento__title\">Ready for AI search</h3>\n\t\t\t\t\t<p>We plan for Google and for AI answers like ChatGPT and Gemini.</p>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t</section>",
    "css": "digital-marketing",
    "modules": []
   }
