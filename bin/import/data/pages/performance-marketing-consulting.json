    "title": "Performance marketing consulting questions, <em>answered</em>",
    "lead": "Can’t find your answer? Ask us on a free 30-minute call.",
    "buttonText": "Contact us",
    "buttonUrl": "/contact/",
    "items": [
     {
      "question": "What does a performance marketing consultant do?",
      "answer": "A performance marketing consultant advises your team on channels, budgets, tracking and campaigns, audits what you run today and helps your team improve, without taking over the accounts."
     },
     {
      "question": "Consultant or agency: which do I need?",
      "answer": "If you have people running your ads, a consultant usually adds more value. If you don’t, an agency that runs the accounts is a better fit."
     },
     {
      "question": "How much does performance marketing consulting cost?",
      "answer": "A fixed monthly fee or a fixed project price, quoted after a free call."
     },
     {
      "question": "Can you oversee our current agency?",
      "answer": "Yes. We review their work, check reports against your CRM and help set clear targets."
     }
    ],
    "buttonStyle": "outline"
   }
