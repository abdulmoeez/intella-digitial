  {
   "name": "intella/faq",
   "attrs": {
    "background": "cream",
    "anchor": "",
    "title": "Real estate SEO questions, <em>answered</em>",
    "lead": "Can’t find your answer? Ask us on a free 30-minute call.",
    "buttonText": "Contact us",
    "buttonUrl": "/contact/",
    "items": [
     {
      "question": "What are real estate SEO services?",
      "answer": "SEO for agencies, brokers and developers: area guides, listing and project pages, agent profiles, local SEO and lead tracking."
     },
     {
      "question": "Can we rank above the property portals?",
      "answer": "For broad searches, portals are hard to beat. For specific areas, projects and property types, a strong agency website often can."
