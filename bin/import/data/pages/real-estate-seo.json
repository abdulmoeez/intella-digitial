   "attrs": {
    "label": "Why real estate SEO pays off",
    "html": "<section class=\"section section--cream\" aria-labelledby=\"h-65\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"split-list\">\n\t\t\t\t<div class=\"split-list__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Leads by source · Example</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-bars\"><div class=\"mock-bar mock-bar--you\"><span>Organic search</span><em><i style=\"width:100%\"></i></em><span class=\"num\">184</span></div><div class=\"mock-bar\"><span>Property portals</span><em><i style=\"width:82%\"></i></em><span class=\"num\">151</span></div><div class=\"mock-bar\"><span>Paid social</span><em><i style=\"width:40%\"></i></em><span class=\"num\">74</span></div><div class=\"mock-bar\"><span>Referrals</span><em><i style=\"width:28%\"></i></em><span class=\"num\">52</span></div></div></div>\n</figure></div>\n\t\t\t\t<div>\n\t\t\t<div class=\"section-head\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-65\">Why real estate SEO <span class=\"accent\">pays off</span></h2>\n\t\t\t\t<p class=\"section-lead\">Portals charge for every lead. Search brings leads you own.</p>\n\t\t\t</div>\n\t\t\t\t\t<ol class=\"nlist\" role=\"list\">\n<li class=\"nlist__item\"><span class=\"nlist__num\">01</span><div><h3 class=\"nlist__title\">Leads you own</h3><p>Visitors come to your website, not a portal listing next to competitors.</p></div></li>\n<li class=\"nlist__item\"><span class=\"nlist__num\">02</span><div><h3 class=\"nlist__title\">Lower cost over time</h3><p>Rankings keep bringing leads after the work is done.</p></div></li>\n<li class=\"nlist__item\"><span class=\"nlist__num\">03</span><div><h3 class=\"nlist__title\">Buyers and sellers</h3><p>Valuation and area pages attract sellers as well as buyers.</p></div></li>\n<li class=\"nlist__item\"><span class=\"nlist__num\">04</span><div><h3 class=\"nlist__title\">Off-plan launches</h3><p>Project pages build interest before launch day.</p></div></li>\n\t\t\t\t\t</ol>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "real-estate-seo",
    "modules": []
   }
