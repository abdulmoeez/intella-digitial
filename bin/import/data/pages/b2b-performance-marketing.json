    "items": [
     {
      "question": "What is B2B performance marketing?",
      "answer": "Paid ads for companies that sell to other businesses, such as Google, LinkedIn and Microsoft ads, measured by qualified leads, pipeline and revenue."
     },
     {
      "question": "Which platforms work best for B2B?",
      "answer": "Google and Microsoft search for people already looking, LinkedIn for reaching decision makers by role and company."
     },
     {
      "question": "How do you measure B2B ads?",
      "answer": "Through your CRM: which campaigns create qualified leads, opportunities and revenue."
     },
     {
      "question": "Do you work with SaaS companies?",
      "answer": "Yes. We track trials, activation and payment, and optimise for paying users."
     }
    ],
