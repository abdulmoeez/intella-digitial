   "name": "intella/faq",
   "attrs": {
    "background": "cream",
    "anchor": "",
    "title": "White-label SEO questions, <em>answered</em>",
    "lead": "Can’t find your answer? Ask us on a free 30-minute call.",
    "buttonText": "Contact us",
    "buttonUrl": "/contact/",
    "items": [
     {
      "question": "What are white-label SEO services?",
      "answer": "SEO work done by us and sold by your agency under your own brand. You keep the client; we do the delivery."
     },
     {
      "question": "What’s the difference between white-label SEO and an SEO reseller?",
      "answer": "They mean the same thing in practice: you resell SEO services delivered by a partner."
     },
     {
      "question": "Will our clients know you’re involved?",
      "answer": "Not unless you tell them. We sign an NDA and everything client-facing carries your brand."
     },
     {
      "question": "Can you join client calls?",
      "answer": "Yes, as part of your team, if you’d like a specialist on the call."
     },
     {
      "question": "How do you price white-label SEO?",
      "answer": "A fixed monthly fee per client, agreed after we see the scope, so you can set your own margin."
     }
    ],
    "buttonStyle": "outline"
   }
