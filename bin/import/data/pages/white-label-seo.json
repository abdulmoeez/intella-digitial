  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "White-label SEO services",
    "html": "<section class=\"section section--white\" aria-labelledby=\"h-70\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-70\">White-label SEO <span class=\"accent\">services</span></h2>\n\t\t\t\t<p class=\"section-lead\">Resell a single service or the whole package.</p>\n\t\t\t</div>\n\t\t\t<ul class=\"packages\" role=\"list\">\n\t\t\t\t<li class=\"package\">\n\t\t\t\t\t\n\t\t\t\t\t<h3 class=\"package__name\">Audits</h3>\n\t\t\t\t\t<p class=\"package__for\">For winning new clients</p>\n\t\t\t\t\t<p class=\"package__text\">White-label SEO audits you can use in pitches and onboarding.</p>\n\t\t\t\t\t<ul class=\"tick-list tick-list--plain\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Technical and content audit</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Prioritised action plan</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Your branding</li></ul>\n\t\t\t\t\t<a class=\"button button--outline button--block\" href=\"#proposal\">Get a quote <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"package package--featured\">\n\t\t\t\t\t<span class=\"package__badge\">Most popular</span>\n\t\t\t\t\t<h3 class=\"package__name\">Full SEO</h3>\n\t\t\t\t\t<p class=\"package__for\">For ongoing clients</p>\n\t\t\t\t\t<p class=\"package__text\">Monthly SEO delivered end to end, reported under your brand.</p>\n\t\t\t\t\t<ul class=\"tick-list tick-list--plain\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Technical SEO and fixes</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Content and on-page</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Link building</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> White-label monthly report</li></ul>\n\t\t\t\t\t<a class=\"button button--light button--block\" href=\"#proposal\">Get a quote <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"package\">\n\t\t\t\t\t\n\t\t\t\t\t<h3 class=\"package__name\">Add-ons</h3>\n\t\t\t\t\t<p class=\"package__for\">For extra capacity</p>\n\t\t\t\t\t<p class=\"package__text\">Individual services when your own team is stretched.</p>\n\t\t\t\t\t<ul class=\"tick-list tick-list--plain\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Content writing</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Link building</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Local SEO and listings</li></ul>\n\t\t\t\t\t<a class=\"button button--outline button--block\" href=\"#proposal\">Get a quote <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t<p class=\"packages__note\">Every plan is quoted after a free call, so you only pay for what you need.</p>\n\t\t</div>\n\t</section>",
    "css": "white-label-seo",
    "modules": []
   }
