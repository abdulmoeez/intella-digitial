  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "A partner you can trust with your clients",
    "html": "<section class=\"section section--cream\" aria-labelledby=\"h-71\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-71\">A partner you can <span class=\"accent\">trust with your clients</span></h2>\n\t\t\t\t<p class=\"section-lead\">Your clients are your business. These are the rules we keep.</p>\n\t\t\t</div>\n\t\t\t<div class=\"dodont\">\n\t\t\t\t<div class=\"dodont__col dodont__col--do\"><h3 class=\"dodont__title\">What we always do</h3><ul role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Keep every client relationship yours</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Use your brand on reports and documents</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Sign an NDA before we start</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Give you full access to the work and data</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Tell you early if something needs attention</li></ul></div>\n\t\t\t\t<div class=\"dodont__col dodont__col--dont\"><h3 class=\"dodont__title\">What we never do</h3><ul role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Contact your clients directly without permission</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Mention Intella on anything client-facing</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Approach your clients for our own services</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Use risky tactics that could harm your reputation</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Hide what we’ve done or why</li></ul></div>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "white-label-seo",
    "modules": []
   }
  },
  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "Inside a white-label SEO report",
    "html": "<section class=\"section section--white\" aria-labelledby=\"h-72\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-72\">Inside a <span class=\"accent\">white-label SEO report</span></h2>\n\t\t\t\t<p class=\"section-lead\">A clear monthly report with your logo, ready to send.</p>\n\t\t\t</div>\n\t\t\t<ol class=\"chaps\" role=\"list\"><li class=\"chap\"><span class=\"chap__num\">01</span><h3 class=\"chap__title\">Summary</h3><p>The month in a few lines: what changed and what it means.</p><span class=\"chap__pages\">1 page</span></li><li class=\"chap\"><span class=\"chap__num\">02</span><h3 class=\"chap__title\">Traffic and leads</h3><p>Organic sessions, leads and conversions, compared with last month and last year.</p><span class=\"chap__pages\">2 pages</span></li><li class=\"chap\"><span class=\"chap__num\">03</span><h3 class=\"chap__title\">Rankings</h3><p>Keyword movements for the searches that matter.</p><span class=\"chap__pages\">1–2 pages</span></li><li class=\"chap\"><span class=\"chap__num\">04</span><h3 class=\"chap__title\">Work completed</h3><p>Every fix, page and link delivered this month.</p><span class=\"chap__pages\">1–2 pages</span></li><li class=\"chap\"><span class=\"chap__num\">05</span><h3 class=\"chap__title\">Next month</h3><p>The plan for the coming month.</p><span class=\"chap__pages\">1 page</span></li></ol>\n\t\t</div>\n\t</section>",
    "css": "white-label-seo",
    "modules": []
   }
  },
