  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "White-label SEO vs hiring in-house",
    "html": "<section class=\"section section--cream\" aria-labelledby=\"h-69\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-69\">White-label SEO vs <span class=\"accent\">hiring in-house</span></h2>\n\t\t\t\t<p class=\"section-lead\">How a white-label partner compares with building your own team.</p>\n\t\t\t</div>\n\t\t\t<div class=\"compare\">\n\t\t\t\t<div class=\"compare__scroll\">\n\t\t\t\t\t<table class=\"compare__table\">\n\t\t\t\t\t\t<thead><tr><th scope=\"col\"><span class=\"visually-hidden\">Feature</span></th><th scope=\"col\" class=\"compare__us\">White-label partner</th><th scope=\"col\">Hiring in-house</th><th scope=\"col\">Freelancers</th></tr></thead>\n\t\t\t\t\t\t<tbody><tr><th scope=\"row\">Ready to start</th><td class=\"compare__us\">Within weeks</td><td>Months to hire</td><td>Varies</td></tr><tr><th scope=\"row\">Technical, content and links covered</th><td class=\"compare__us\"><span class=\"compare__yes\" aria-label=\"Yes\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg></span></td><td>Needs several hires</td><td>Rarely all three</td></tr><tr><th scope=\"row\">Scales up and down with clients</th><td class=\"compare__us\"><span class=\"compare__yes\" aria-label=\"Yes\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg></span></td><td><span class=\"compare__no\" aria-label=\"No\">–</span></td><td>Partly</td></tr><tr><th scope=\"row\">White-label reports</th><td class=\"compare__us\"><span class=\"compare__yes\" aria-label=\"Yes\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg></span></td><td>You build them</td><td><span class=\"compare__no\" aria-label=\"No\">–</span></td></tr><tr><th scope=\"row\">Developers to make fixes</th><td class=\"compare__us\"><span class=\"compare__yes\" aria-label=\"Yes\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg></span></td><td>Extra hires</td><td><span class=\"compare__no\" aria-label=\"No\">–</span></td></tr><tr><th scope=\"row\">Fixed monthly cost per client</th><td class=\"compare__us\"><span class=\"compare__yes\" aria-label=\"Yes\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg></span></td><td><span class=\"compare__no\" aria-label=\"No\">–</span></td><td>Varies</td></tr></tbody>\n\t\t\t\t\t</table>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "white-label-seo",
    "modules": []
   }
