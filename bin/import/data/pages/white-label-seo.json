   "name": "intella/custom-section",
   "attrs": {
    "label": "White-label SEO services, delivered under your brand",
    "html": "<section class=\"page-hero\" aria-labelledby=\"page-title\">\n\t\t<div class=\"container page-hero__inner\">\n\t\t\t<div>\n\t\t\t\t<nav class=\"breadcrumb\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/\">Home</a></li><li><a href=\"/services/\">Services</a></li><li><a href=\"/services/digital-marketing/seo/\">SEO</a></li><li aria-current=\"page\">White-Label SEO</li></ol></nav>\n\t\t\t\t<h1 class=\"page-hero__title\" id=\"page-title\">White-label SEO services, <span class=\"accent\">delivered under your brand</span></h1>\n\t\t\t\t<p class=\"page-hero__lead\">Offer SEO to your clients without hiring a team. We do the work behind the scenes, you keep the client relationship, and every report carries your logo.</p>\n\t\t\t\t<ul class=\"note-list\" role=\"list\">\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Your brand on every report</li>\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> No contact with your clients unless you want it</li>\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Senior specialists, flexible capacity</li>\n\t\t\t\t</ul>\n\t\t\t\t<div class=\"hero__actions\">\n\t\t\t\t\t<a class=\"button button--primary button--lg\" href=\"#proposal\">Request a proposal <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t\t<a class=\"button button--outline button--lg\" href=\"#process-title\">See how it works</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"page-hero__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Monthly SEO report · Your Agency logo here</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-stats\"><div class=\"mock-stat mock-stat--violet\"><div class=\"mock-stat__label\">Organic sessions</div><div class=\"mock-stat__value\">24.6K</div><span class=\"mock-up\">▲ +38%</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Leads from search</div><div class=\"mock-stat__value\">186</div><span class=\"mock-up\">▲ +52%</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Top-10 keywords</div><div class=\"mock-stat__value\">142</div><span class=\"mock-up\">▲ +61</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Tasks completed</div><div class=\"mock-stat__value\">34</div><span class=\"mock-up\">▲ </span></div></div><div class=\"mock-scroll\"><table class=\"mock-table\"><thead><tr><th>This month</th><th>Status</th></tr></thead><tbody><tr><td>12 pages optimised</td><td><span class=\"mock-chip mock-chip--ok\">Done</span></td></tr><tr><td>Technical fixes</td><td><span class=\"mock-chip mock-chip--ok\">Done</span></td></tr><tr><td>4 new articles</td><td><span class=\"mock-chip mock-chip--warn\">In review</span></td></tr></tbody></table></div></div>\n</figure></div>\n\t\t</div>\n\t</section>",
    "css": "white-label-seo",
    "modules": []
   }
