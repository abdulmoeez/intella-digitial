   "attrs": {
    "label": "Healthcare SEO services that bring in new patients",
    "html": "<section class=\"page-hero\" aria-labelledby=\"page-title\">\n\t\t<div class=\"container page-hero__inner\">\n\t\t\t<div>\n\t\t\t\t<nav class=\"breadcrumb\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/\">Home</a></li><li><a href=\"/services/\">Services</a></li><li><a href=\"/services/digital-marketing/seo/\">SEO</a></li><li aria-current=\"page\">Healthcare SEO</li></ol></nav>\n\t\t\t\t<h1 class=\"page-hero__title\" id=\"page-title\">Healthcare SEO services that bring in <span class=\"accent\">new patients</span></h1>\n\t\t\t\t<p class=\"page-hero__lead\">Patients search before they book. We help clinics, practices and health brands show up for the right searches, with content that earns trust and pages that make booking easy.</p>\n\t\t\t\t<ul class=\"note-list\" role=\"list\">\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Medical content reviewed for accuracy</li>\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Local SEO for every clinic location</li>\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Bookings and calls tracked</li>\n\t\t\t\t</ul>\n\t\t\t\t<div class=\"hero__actions\">\n\t\t\t\t\t<a class=\"button button--primary button--lg\" href=\"#proposal\">Request a proposal <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t\t<a class=\"button button--outline button--lg\" href=\"#who\">See who we help</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"page-hero__visual\"><figure class=\"mock mk-browser\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mk-browser__url\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-key\"/></svg> yourclinic.com/dental-implants</span></div>\n\t<div class=\"mk-browser__body\"><div class=\"wf-hero\"><p class=\"wf-kicker\">Reviewed by Dr. Sara Khan, BDS</p><p class=\"wf-title\">Dental implants in Dubai Marina</p><span class=\"wf-line\"></span><span class=\"wf-line wf-line--short\"></span><span class=\"wf-btn\">Book a consultation</span></div><div class=\"wf-cards\"><span></span><span></span><span></span></div><div class=\"wf-reviews\"><span><span class=\"mk-stars\"><span aria-hidden=\"true\">★★★★★</span></span></span><span><span class=\"mk-stars\"><span aria-hidden=\"true\">★★★★★</span></span></span><span><span class=\"mk-stars\"><span aria-hidden=\"true\">★★★★★</span></span></span></div><div class=\"wf-faq\"><span></span><span></span><span></span></div></div>\n</figure></div>\n\t\t</div>\n\t</section>",
