  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "Health content patients can trust",
    "html": "<section class=\"section section--white\" aria-labelledby=\"h-54\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-54\">Health content patients <span class=\"accent\">can trust</span></h2>\n\t\t\t\t<p class=\"section-lead\">Google holds health content to a higher standard. So do we.</p>\n\t\t\t</div>\n\t\t\t<div class=\"dodont\">\n\t\t\t\t<div class=\"dodont__col dodont__col--do\"><h3 class=\"dodont__title\">What we do</h3><ul role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Have content reviewed by a qualified professional</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Show author and reviewer credentials</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Cite trusted medical sources</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Keep treatment pages up to date</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Follow advertising rules in your market</li></ul></div>\n\t\t\t\t<div class=\"dodont__col dodont__col--dont\"><h3 class=\"dodont__title\">What we never do</h3><ul role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Promise outcomes or cures</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Publish medical advice without review</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Use patient details or photos without consent</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Copy content from other clinics</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Buy fake reviews</li></ul></div>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "healthcare-seo",
    "modules": []
   }
  },
  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "From search to booked appointment",
    "html": "<section class=\"section section--cream process\" aria-labelledby=\"process-title\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"process-title\">From search to <span class=\"accent\">booked appointment</span></h2>\n\t\t\t\t<p class=\"section-lead\">A plan that starts with the treatments that matter most to your practice.</p>\n\t\t\t</div>\n\t\t\t<ol class=\"steps-row\" role=\"list\">\n\t\t\t\t<li class=\"steps-row__item\">\n\t\t\t\t\t<span class=\"steps-row__num\">01</span>\n\t\t\t\t\t<h3 class=\"steps-row__title\">Practice review</h3>\n\t\t\t\t\t<p>Your rankings, profiles, reviews and competitors for each location and treatment.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"steps-row__item\">\n\t\t\t\t\t<span class=\"steps-row__num\">02</span>\n\t\t\t\t\t<h3 class=\"steps-row__title\">Fix the basics</h3>\n\t\t\t\t\t<p>Google Business Profiles, site speed and booking paths.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"steps-row__item\">\n\t\t\t\t\t<span class=\"steps-row__num\">03</span>\n\t\t\t\t\t<h3 class=\"steps-row__title\">Treatment content</h3>\n\t\t\t\t\t<p>Pages for your key treatments, reviewed by your clinicians.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"steps-row__item\">\n\t\t\t\t\t<span class=\"steps-row__num\">04</span>\n\t\t\t\t\t<h3 class=\"steps-row__title\">Track bookings</h3>\n\t\t\t\t\t<p>Calls, forms and online bookings tracked and reported monthly.</p>\n\t\t\t\t</li>\n\t\t\t</ol>\n\t\t</div>\n\t</section>",
    "css": "healthcare-seo",
    "modules": []
   }
