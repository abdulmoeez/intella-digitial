    "title": "Healthcare SEO questions, <em>answered</em>",
    "lead": "Can’t find your answer? Ask us on a free 30-minute call.",
    "buttonText": "Contact us",
    "buttonUrl": "/contact/",
    "items": [
     {
      "question": "What are healthcare SEO services?",
      "answer": "SEO for clinics, practices and health brands: treatment and condition content, doctor profiles, local SEO, technical fixes and booking tracking."
     },
     {
      "question": "Do you do SEO for dentists?",
      "answer": "Yes. Dental SEO is one of the most common requests we get: treatment pages, reviews and map pack rankings for each practice."
     },
     {
      "question": "Who writes the medical content?",
      "answer": "Specialist health writers, with every page reviewed and approved by a qualified person at your practice."
     },
     {
      "question": "Do you handle patient data?",
      "answer": "No. Our work doesn’t need patient records. Forms and tracking are set up so no health data is sent to analytics tools."
     },
     {
      "question": "Can you help with several clinic locations?",
      "answer": "Yes. We manage pages, profiles and reporting for each location."
     }
    ],
    "buttonStyle": "outline"
   }
