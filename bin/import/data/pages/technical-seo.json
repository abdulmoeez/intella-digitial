   "name": "intella/custom-section",
   "attrs": {
    "label": "Technical SEO services that keep your site fast and found",
    "html": "<section class=\"page-hero page-hero--center hero-wide\" aria-labelledby=\"page-title\">\n\t\t<div class=\"container\">\n\t\t\t<nav class=\"breadcrumb\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/\">Home</a></li><li><a href=\"/services/\">Services</a></li><li><a href=\"/services/digital-marketing/seo/\">SEO</a></li><li aria-current=\"page\">Technical SEO</li></ol></nav>\n\t\t\t<h1 class=\"page-hero__title\" id=\"page-title\">Technical SEO services that keep your site <span class=\"accent\">fast and found</span></h1>\n\t\t\t<p class=\"page-hero__lead\">An audit finds the problems once. Our technical SEO service keeps finding and fixing them every month, as your site, your team and Google keep changing.</p>\n\t\t\t<div class=\"hero__actions hero__actions--center\">\n\t\t\t\t<a class=\"button button--primary button--lg\" href=\"#proposal\">Request a proposal <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t<a class=\"button button--outline button--lg\" href=\"#process-title\">See what we monitor</a>\n\t\t\t</div>\n\t\t\t<ul class=\"chip-row chip-row--plain\" role=\"list\"><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Weekly crawls and alerts</span></li><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Fixes shipped by our developers</span></li><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Core Web Vitals kept in the green</span></li></ul>\n\t\t\t<div class=\"hero-wide__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Technical SEO · Weekly monitoring</span></div>\n\t<div class=\"mock__body\"><div class=\"mk-two\"><div><div class=\"mock-stats\"><div class=\"mock-stat mock-stat--violet\"><div class=\"mock-stat__label\">Indexable pages</div><div class=\"mock-stat__value\">3,184</div><span class=\"mock-up\">▲ +412</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Crawl errors</div><div class=\"mock-stat__value\">12</div><span class=\"mock-up\">▲ from 286</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Pages passing CWV</div><div class=\"mock-stat__value\">94%</div><span class=\"mock-up\">▲ +51 pts</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Avg. response time</div><div class=\"mock-stat__value\">210 ms</div><span class=\"mock-up\">▲ from 940 ms</span></div></div><svg class=\"mock-chart\" viewBox=\"0 0 640 160\" role=\"img\" aria-label=\"Pages passing Core Web Vitals over 12 months\"><defs><linearGradient id=\"g39720\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#8f2cf4\" stop-opacity=\"0.28\"/><stop offset=\"1\" stop-color=\"#8f2cf4\" stop-opacity=\"0\"/></linearGradient></defs><line x1=\"16\" x2=\"622\" y1=\"12.0\" y2=\"12.0\" stroke=\"#efeaf2\"/><line x1=\"16\" x2=\"622\" y1=\"42.5\" y2=\"42.5\" stroke=\"#efeaf2\"/><line x1=\"16\" x2=\"622\" y1=\"73.0\" y2=\"73.0\" stroke=\"#efeaf2\"/><line x1=\"16\" x2=\"622\" y1=\"103.5\" y2=\"103.5\" stroke=\"#efeaf2\"/><line x1=\"16\" x2=\"622\" y1=\"134.0\" y2=\"134.0\" stroke=\"#efeaf2\"/><path d=\"M16.0,83.3 L71.1,80.9 L126.2,72.6 L181.3,65.6 L236.4,59.7 L291.5,51.4 L346.5,44.3 L401.6,38.4 L456.7,32.5 L511.8,29.0 L566.9,25.5 L622.0,23.1 L622.0,134 L16.0,134 Z\" fill=\"url(#g39720)\"/><path d=\"M16.0,83.3 L71.1,80.9 L126.2,72.6 L181.3,65.6 L236.4,59.7 L291.5,51.4 L346.5,44.3 L401.6,38.4 L456.7,32.5 L511.8,29.0 L566.9,25.5 L622.0,23.1\" fill=\"none\" stroke=\"#8f2cf4\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><circle cx=\"622.0\" cy=\"23.1\" r=\"4\" fill=\"#fff\" stroke=\"#8f2cf4\" stroke-width=\"2.5\"/><text x=\"16.0\" y=\"154\" text-anchor=\"middle\">Jan</text><text x=\"126.2\" y=\"154\" text-anchor=\"middle\">Mar</text><text x=\"236.4\" y=\"154\" text-anchor=\"middle\">May</text><text x=\"346.5\" y=\"154\" text-anchor=\"middle\">Jul</text><text x=\"456.7\" y=\"154\" text-anchor=\"middle\">Sep</text><text x=\"566.9\" y=\"154\" text-anchor=\"middle\">Nov</text><text x=\"622.0\" y=\"154\" text-anchor=\"middle\">Dec</text></svg><div class=\"mock-legend\"><span><i style=\"background:#8f2cf4\"></i>Pages passing Core Web Vitals (%)</span></div></div><div><p class=\"mock__heading\">This week’s alerts</p><div class=\"mock-scroll\"><table class=\"mock-table\"><thead><tr><th>Issue</th><th class=\"num\">Pages</th><th>Status</th></tr></thead><tbody><tr><td>Noindex on new blog posts</td><td class=\"num\">14</td><td><span class=\"mock-chip mock-chip--ok\">Fixed</span></td></tr><tr><td>Redirect chains</td><td class=\"num\">38</td><td><span class=\"mock-chip mock-chip--warn\">In progress</span></td></tr><tr><td>Missing canonical tags</td><td class=\"num\">6</td><td><span class=\"mock-chip mock-chip--ok\">Fixed</span></td></tr><tr><td>Slow LCP on /pricing</td><td class=\"num\">1</td><td><span class=\"mock-chip mock-chip--bad\">New</span></td></tr><tr><td>Broken internal links</td><td class=\"num\">22</td><td><span class=\"mock-chip mock-chip--ok\">Fixed</span></td></tr></tbody></table></div></div></div></div>\n</figure></div>\n\t\t</div>\n\t</section>",
