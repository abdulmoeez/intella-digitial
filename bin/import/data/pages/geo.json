  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "From invisible to recommended",
    "html": "<section class=\"section section--cream showcase\" aria-labelledby=\"showcase-title\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"showcase-title\">From invisible to <span class=\"accent\">recommended</span></h2>\n\t\t\t\t<p class=\"section-lead\">We track the questions your buyers ask AI tools and report how often your brand is part of the answer, and the visits and leads that follow.</p>\n\t\t\t</div>\n\t\t\t<div class=\"showcase__grid\">\n\t\t\t\t<div class=\"showcase__main\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">AI visibility tracker · 20 buyer questions</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-stats\"><div class=\"mock-stat mock-stat--violet\"><div class=\"mock-stat__label\">Questions where you are mentioned</div><div class=\"mock-stat__value\">14 / 20</div><span class=\"mock-up\">▲ from 3</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">ChatGPT</div><div class=\"mock-stat__value\">12</div><span class=\"mock-up\">▲ +9</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Gemini</div><div class=\"mock-stat__value\">10</div><span class=\"mock-up\">▲ +8</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Perplexity</div><div class=\"mock-stat__value\">13</div><span class=\"mock-up\">▲ +10</span></div></div><div class=\"mock-scroll\"><table class=\"mock-table\"><thead><tr><th>Buyer question</th><th>ChatGPT</th><th>Gemini</th><th>Perplexity</th><th>AI Overviews</th></tr></thead><tbody><tr><td>Best SEO agency for small businesses</td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-no\" aria-label=\"Not mentioned\">–</span></td></tr><tr><td>Who can build a Laravel web app?</td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-no\" aria-label=\"Not mentioned\">–</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td></tr><tr><td>How much does a WordPress website cost?</td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td></tr><tr><td>Recommended agency for Google Ads audits</td><td><span class=\"mock-no\" aria-label=\"Not mentioned\">–</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-no\" aria-label=\"Not mentioned\">–</span></td></tr><tr><td>Which agency helps with AI search (GEO)?</td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td><td><span class=\"mock-no\" aria-label=\"Not mentioned\">–</span></td><td><span class=\"mock-yes\" aria-label=\"Mentioned\">✓</span></td></tr></tbody></table></div></div>\n</figure></div>\n\t\t\t\t<div class=\"showcase__side\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Share of AI answers · Your market</span></div>\n\t<div class=\"mock__body\"><p class=\"mock__heading\">How often each brand is recommended</p><div class=\"mock-bars\"><div class=\"mock-bar mock-bar--you\"><span>Your brand</span><em><i style=\"width:70%\"></i></em><span class=\"num\">70%</span></div><div class=\"mock-bar\"><span>Competitor A</span><em><i style=\"width:45%\"></i></em><span class=\"num\">45%</span></div><div class=\"mock-bar\"><span>Competitor B</span><em><i style=\"width:30%\"></i></em><span class=\"num\">30%</span></div><div class=\"mock-bar\"><span>Competitor C</span><em><i style=\"width:15%\"></i></em><span class=\"num\">15%</span></div></div><p class=\"mock__heading\" style=\"margin-top:1.1rem\">Visits from AI tools (GA4)</p><svg class=\"mock-chart\" viewBox=\"0 0 640 150\" role=\"img\" aria-label=\"Monthly visits from AI tools\"><rect x=\"17.0\" y=\"118.2\" width=\"30.4\" height=\"7.8\" rx=\"4\" fill=\"#cbb7e4\"/><text x=\"32.2\" y=\"144\" text-anchor=\"middle\">Jan</text><rect x=\"69.3\" y=\"115.3\" width=\"30.4\" height=\"10.7\" rx=\"4\" fill=\"#cbb7e4\"/><rect x=\"121.7\" y=\"112.3\" width=\"30.4\" height=\"13.7\" rx=\"4\" fill=\"#cbb7e4\"/><text x=\"136.8\" y=\"144\" text-anchor=\"middle\">Mar</text><rect x=\"174.0\" y=\"108.4\" width=\"30.4\" height=\"17.6\" rx=\"4\" fill=\"#cbb7e4\"/><rect x=\"226.3\" y=\"102.5\" width=\"30.4\" height=\"23.5\" rx=\"4\" fill=\"#cbb7e4\"/><text x=\"241.5\" y=\"144\" text-anchor=\"middle\">May</text><rect x=\"278.7\" y=\"94.7\" width=\"30.4\" height=\"31.3\" rx=\"4\" fill=\"#cbb7e4\"/><rect x=\"331.0\" y=\"85.0\" width=\"30.4\" height=\"41.0\" rx=\"4\" fill=\"#cbb7e4\"/><text x=\"346.2\" y=\"144\" text-anchor=\"middle\">Jul</text><rect x=\"383.3\" y=\"75.2\" width=\"30.4\" height=\"50.8\" rx=\"4\" fill=\"#cbb7e4\"/><rect x=\"435.7\" y=\"63.5\" width=\"30.4\" height=\"62.5\" rx=\"4\" fill=\"#cbb7e4\"/><text x=\"450.8\" y=\"144\" text-anchor=\"middle\">Sep</text><rect x=\"488.0\" y=\"51.7\" width=\"30.4\" height=\"74.3\" rx=\"4\" fill=\"#8f2cf4\"/><rect x=\"540.3\" y=\"38.1\" width=\"30.4\" height=\"87.9\" rx=\"4\" fill=\"#8f2cf4\"/><text x=\"555.5\" y=\"144\" text-anchor=\"middle\">Nov</text><rect x=\"592.7\" y=\"22.4\" width=\"30.4\" height=\"103.6\" rx=\"4\" fill=\"#8f2cf4\"/><text x=\"607.8\" y=\"144\" text-anchor=\"middle\">Dec</text></svg></div>\n</figure></div>\n\t\t\t</div>\n\t\t\t<ul class=\"outcomes\" role=\"list\"><li><span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-sparkle\"/></svg></span><div><h3 class=\"outcome__title\">Named in more AI answers</h3><p>Your brand recommended for the questions that matter.</p></div></li><li><span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-trend\"/></svg></span><div><h3 class=\"outcome__title\">Traffic from AI tools</h3><p>Visits from ChatGPT, Perplexity and Gemini tracked in GA4.</p></div></li><li><span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-users\"/></svg></span><div><h3 class=\"outcome__title\">Ahead of competitors</h3><p>A bigger share of AI recommendations in your market.</p></div></li></ul>\n\t\t</div>\n\t</section>",
    "css": "geo",
    "modules": []
   }
