  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "What our clients say",
    "html": "<section class=\"section section--white section--flush-top\" aria-label=\"What our clients say\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"quote-strip\">\n\t\t\t\t<div class=\"quote-row quote-row--two\">\n\t\t\t\t\t<figure class=\"quote-card quote-card--dark\">\n\t\t\t\t\t\t<blockquote><p>“The team exceeded our expectations from start to finish. They built a modern, high-performing platform that has helped us better engage our customers and confidently showcase our product.”</p></blockquote>\n\t\t\t\t\t\t<figcaption class=\"person\">\n\t\t\t\t\t\t\t<img src=\"{{media:assets/images/people/david-clarke.jpg}}\" width=\"300\" height=\"300\" alt=\"\" loading=\"lazy\">\n\t\t\t\t\t\t\t<div><p class=\"person__name\">David Clarke</p><p class=\"person__role\">CEO &amp; Founder, Cupello</p></div>\n\t\t\t\t\t\t</figcaption>\n\t\t\t\t\t</figure>\n\t\t\t\t\t<figure class=\"quote-card\">\n\t\t\t\t\t\t<blockquote><p>“Intella Digital delivered a website that perfectly captured our brand and vision. Their attention to detail, responsiveness, and ability to turn ideas into reality made the entire process smooth and enjoyable.”</p></blockquote>\n\t\t\t\t\t\t<figcaption class=\"person\">\n\t\t\t\t\t\t\t<img src=\"{{media:assets/images/people/andra-simina-mocanu.jpg}}\" width=\"300\" height=\"300\" alt=\"\" loading=\"lazy\">\n\t\t\t\t\t\t\t<div><p class=\"person__name\">Andra-Simina Mocanu</p><p class=\"person__role\">CEO &amp; Founder, The Other Glasses</p></div>\n\t\t\t\t\t\t</figcaption>\n\t\t\t\t\t</figure>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "geo",
    "modules": []
   }
