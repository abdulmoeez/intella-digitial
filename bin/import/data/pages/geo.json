  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "What goes into AI visibility",
    "html": "<section class=\"section section--cream\" aria-labelledby=\"included-title\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head\">\n\t\t\t\t<h2 class=\"section-title\" id=\"included-title\">What goes into <span class=\"accent\">AI visibility</span></h2>\n\t\t\t\t<p class=\"section-lead\">GEO is still evolving, so we focus on the groundwork that helps AI tools trust and cite your content.</p>\n\t\t\t</div>\n\t\t\t<div class=\"service-card\">\n\t\t\t\t<ul class=\"service-card__list service-card__list--3\" role=\"list\">\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-chart\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">AI visibility audit</h3><p class=\"service-item__text\">How AI tools describe your brand and competitors today, and where you’re missing.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-users\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Question research</h3><p class=\"service-item__text\">The conversational questions your buyers ask AI assistants about your services.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-pen\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Answer-ready content</h3><p class=\"service-item__text\">Clear pages, FAQs and guides that answer those questions directly.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-code\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Structured data</h3><p class=\"service-item__text\">Schema markup that helps machines understand your business, services and content.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-layers\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Entity and brand signals</h3><p class=\"service-item__text\">Consistent information about your business across your site and trusted sources.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-trend\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Measurement</h3><p class=\"service-item__text\">Tracking of AI mentions, referral traffic from AI tools and the enquiries they bring.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class=\"audit-row\">\n\t\t\t\t<p><strong>Works well with</strong> GEO builds on the same foundations as SEO and content.</p>\n\t\t\t\t<ul class=\"audit-row__chips\" role=\"list\"><li><a class=\"chip\" href=\"/services/digital-marketing/seo/\">SEO</a></li><li><a class=\"chip\" href=\"/services/digital-marketing/content-marketing/\">Content marketing</a></li><li><a class=\"chip\" href=\"/audits/website-audit/\">Website audit</a></li></ul>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "geo",
    "modules": []
