  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "How we get you into AI answers",
    "html": "<section class=\"section section--cream process\" aria-labelledby=\"process-title\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"process-title\">How we get you into <span class=\"accent\">AI answers</span></h2>\n\t\t\t\t<p class=\"section-lead\">A practical process, from understanding where you stand today to tracking what changes.</p>\n\t\t\t</div>\n\t\t\t<ol class=\"tilt-grid\" role=\"list\">\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"tilt-card__num\" aria-hidden=\"true\">01</span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Audit</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">We check how AI tools talk about your brand and which questions you’re missing from.</p>\n\t\t\t\t\t<ul class=\"tick-list\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> AI visibility check</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Competitor comparison</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Technical readiness</li></ul>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"tilt-card__num\" aria-hidden=\"true\">02</span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Research and plan</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">We map the questions your buyers ask and plan the content and fixes to answer them.</p>\n\t\t\t\t\t<ul class=\"tick-list\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Question mapping</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Content plan</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Priority list</li></ul>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"tilt-card__num\" aria-hidden=\"true\">03</span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Create and structure</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">We publish answer-ready content and add the structure AI tools rely on.</p>\n\t\t\t\t\t<ul class=\"tick-list\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> New and improved pages</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Schema markup</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Brand consistency</li></ul>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"tilt-card__num\" aria-hidden=\"true\">04</span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Measure and refine</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">We track mentions and AI referral traffic, report monthly and keep refining.</p>\n\t\t\t\t\t<ul class=\"tick-list\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> AI mention tracking</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Monthly reports</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Ongoing updates</li></ul>\n\t\t\t\t</li>\n\t\t\t</ol>\n\t\t</div>\n\t</section>",
    "css": "geo",
    "modules": []
   }
  },
  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "Where we track your visibility",
    "html": "<section class=\"section section--cream section--flush-top toolkit\" aria-labelledby=\"tools-title\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"toolkit__inner\">\n\t\t\t\t<div>\n\t\t\t\t\t<h2 class=\"toolkit__title\" id=\"tools-title\">Where we track <span class=\"accent\">your visibility</span></h2>\n\t\t\t\t</div>\n\t\t\t\t<ul class=\"toolkit__list\" role=\"list\"><li class=\"tool\">ChatGPT</li><li class=\"tool\">Google Gemini</li><li class=\"tool\">Perplexity</li><li class=\"tool\">Google AI Overviews</li><li class=\"tool\">Microsoft Copilot</li><li class=\"tool\">Claude</li><li class=\"tool\">Schema.org</li><li class=\"tool\">Google Analytics 4</li></ul>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
