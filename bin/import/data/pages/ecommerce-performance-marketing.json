    "title": "eCommerce performance marketing questions, <em>answered</em>",
    "lead": "Can’t find your answer? Ask us on a free 30-minute call.",
    "buttonText": "Contact us",
    "buttonUrl": "/contact/",
    "items": [
     {
      "question": "What is eCommerce performance marketing?",
      "answer": "Paid ads for online stores, such as Google Shopping, Performance Max, Meta, TikTok and Amazon, managed to grow sales and profit, and measured in your store."
     },
     {
      "question": "Which platforms are best for eCommerce?",
      "answer": "Usually Google Shopping and Performance Max for people searching, Meta and TikTok for discovery, and Amazon if you sell there."
     },
     {
      "question": "Do you work with Shopify and WooCommerce?",
      "answer": "Yes. We set up tracking and feeds for Shopify, WooCommerce and most other platforms. We build stores too."
     },
     {
      "question": "What is a good ROAS for eCommerce?",
      "answer": "It depends on your margins. We set targets by product group from your real margins."
     }
    ],
    "buttonStyle": "outline"
   }
