  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "SEO from a team that can also build",
    "html": "<section class=\"section section--white\" aria-labelledby=\"choose-title\">\n\t\t<div class=\"container why\">\n\t\t\t<div>\n\t\t\t\t<h2 class=\"section-title\" id=\"choose-title\">SEO from a team that can also <span class=\"accent\">build</span></h2>\n\t\t\t\t<p class=\"section-lead\">Many SEO recommendations need a developer. Ours don’t wait in a queue, because our developers are on the same team.</p>\n\t\t\t\t<div class=\"why__actions\">\n\t\t\t\t\t<a class=\"button button--primary button--lg\" href=\"#proposal\">Request a proposal <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<ul class=\"bento\" role=\"list\">\n\t\t\t\t<li class=\"bento__card bento__card--dark\">\n\t\t\t\t\t<span class=\"icon-tile icon-tile--dark\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-code\"/></svg></span>\n\t\t\t\t\t<h3 class=\"bento__title\">Fixes, not just reports</h3>\n\t\t\t\t\t<p>Our developers implement the technical changes, so recommendations actually go live.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"bento__card\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-sparkle\"/></svg></span>\n\t\t\t\t\t<h3 class=\"bento__title\">Ready for AI search</h3>\n\t\t\t\t\t<p>We optimise for Google and for the AI assistants your buyers now use.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"bento__card\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-chart\"/></svg></span>\n\t\t\t\t\t<h3 class=\"bento__title\">Reporting you can read</h3>\n\t\t\t\t\t<p>Clear monthly reports that tie the work to enquiries, not vanity metrics.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"bento__card bento__card--dark\">\n\t\t\t\t\t<span class=\"icon-tile icon-tile--dark\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-key\"/></svg></span>\n\t\t\t\t\t<h3 class=\"bento__title\">You own everything</h3>\n\t\t\t\t\t<p>Your content, accounts and data always stay in your name.</p>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t</section>",
