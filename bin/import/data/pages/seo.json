   "name": "intella/custom-section",
   "attrs": {
    "label": "From audit to page 1",
    "html": "<section class=\"section section--cream process\" aria-labelledby=\"process-title\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"process-title\">From audit to <span class=\"accent\">page 1</span></h2>\n\t\t\t\t<p class=\"section-lead\">A clear, step-by-step approach, so you always know what we’re doing and why.</p>\n\t\t\t</div>\n\t\t\t<ol class=\"tilt-grid\" role=\"list\">\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"tilt-card__num\" aria-hidden=\"true\">01</span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Audit</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">We review your site, rankings and competitors to find what’s holding you back.</p>\n\t\t\t\t\t<ul class=\"tick-list\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Technical health check</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Keyword and competitor gaps</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Quick wins list</li></ul>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"tilt-card__num\" aria-hidden=\"true\">02</span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Strategy</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">We turn the findings into a prioritised plan tied to your business goals.</p>\n\t\t\t\t\t<ul class=\"tick-list\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Target keywords per page</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> 90-day roadmap</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Agreed success measures</li></ul>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"tilt-card__num\" aria-hidden=\"true\">03</span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Optimise and create</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">We fix the technical issues, improve key pages and publish new content.</p>\n\t\t\t\t\t<ul class=\"tick-list\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Technical fixes</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Page improvements</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> New content and links</li></ul>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"tilt-card__num\" aria-hidden=\"true\">04</span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Measure and grow</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">We track rankings and enquiries, report every month and keep improving.</p>\n\t\t\t\t\t<ul class=\"tick-list\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Monthly reports</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Ongoing testing</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Plan updates</li></ul>\n\t\t\t\t</li>\n\t\t\t</ol>\n\t\t</div>\n\t</section>",
    "css": "seo",
    "modules": []
   }
