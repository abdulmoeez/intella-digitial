  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "Everything your site needs to rank",
    "html": "<section class=\"section section--cream\" aria-labelledby=\"included-title\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head\">\n\t\t\t\t<h2 class=\"section-title\" id=\"included-title\">Everything your site needs to <span class=\"accent\">rank</span></h2>\n\t\t\t\t<p class=\"section-lead\">Every SEO plan is built around your goals, but these are the areas we usually work on.</p>\n\t\t\t</div>\n\t\t\t<div class=\"service-card\">\n\t\t\t\t<ul class=\"service-card__list service-card__list--3\" role=\"list\">\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-code\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Technical SEO</h3><p class=\"service-item__text\">Crawling, indexing, site speed, Core Web Vitals, redirects and structured data.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-search\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Keyword research</h3><p class=\"service-item__text\">The searches your buyers make, mapped to the pages that should win them.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-browser\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">On-page optimisation</h3><p class=\"service-item__text\">Titles, headings, copy and internal links that match what people are looking for.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-pen\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Content</h3><p class=\"service-item__text\">Service pages, guides and articles that answer questions and earn links.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-users\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Local SEO</h3><p class=\"service-item__text\">Google Business Profile, local pages and reviews for businesses that serve an area.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li class=\"service-item\">\n\t\t\t\t\t\t\t<svg class=\"service-item__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-chart\"/></svg>\n\t\t\t\t\t\t\t<div><h3 class=\"service-item__title\">Tracking and reporting</h3><p class=\"service-item__text\">Rankings, traffic and enquiries in a clear monthly report.</p></div>\n\t\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class=\"audit-row\">\n\t\t\t\t<p><strong>Works well with</strong> SEO gets stronger alongside AI search and content.</p>\n\t\t\t\t<ul class=\"audit-row__chips\" role=\"list\"><li><a class=\"chip\" href=\"/services/digital-marketing/geo/\">GEO / AI search</a></li><li><a class=\"chip\" href=\"/services/digital-marketing/content-marketing/\">Content marketing</a></li><li><a class=\"chip\" href=\"/audits/website-audit/\">Website audit</a></li></ul>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "seo",
    "modules": []
   }
  },
  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "How we move you up the rankings",
    "html": "<section class=\"section section--white methods\" aria-labelledby=\"methods-title\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"methods-title\">How we move you <span class=\"accent\">up the rankings</span></h2>\n\t\t\t\t<p class=\"section-lead\">The same tools and checks we use for every client, from the first audit to the monthly report.</p>\n\t\t\t</div>\n\t\t\t<div class=\"feature-row\">\n\t\t\t\t<div class=\"feature-row__text\">\n\t\t\t\t\t<h3 class=\"feature-row__title\">We find and fix what holds your site back</h3>\n\t\t\t\t\t<p>A full crawl of your site shows speed, indexing and structure problems. Our developers fix them, so the recommendations don’t sit in a report.</p>\n\t\t\t\t\t<ul class=\"tick-list tick-list--plain\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Crawl and Core Web Vitals review</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Prioritised fix list</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Fixes shipped by our developers</li></ul>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"feature-row__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Site audit · yourcompany.com</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-score\"><div class=\"mock-score__ring\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle cx=\"32\" cy=\"32\" r=\"26\" fill=\"none\" stroke=\"#ece6f0\" stroke-width=\"7\"/><circle cx=\"32\" cy=\"32\" r=\"26\" fill=\"none\" stroke=\"#16a35b\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-dasharray=\"150.3 163.4\"/></svg><b>92</b></div><div class=\"mock-score__text\"><strong>Site health 92 / 100</strong>Up from 61 after the first month of fixes.</div></div><ul class=\"mock-list\"><li><span>Slow LCP on mobile templates</span><span class=\"mock-chip mock-chip--ok\">Fixed</span></li><li><span>148 broken internal links</span><span class=\"mock-chip mock-chip--ok\">Fixed</span></li><li><span>Duplicate title tags on 36 pages</span><span class=\"mock-chip mock-chip--ok\">Fixed</span></li><li><span>Missing schema on service pages</span><span class=\"mock-chip mock-chip--warn\">In progress</span></li><li><span>Orphan pages without internal links</span><span class=\"mock-chip mock-chip--muted\">Planned</span></li></ul></div>\n</figure></div>\n\t\t\t</div>\n\t\t\t<div class=\"feature-row feature-row--flip\">\n\t\t\t\t<div class=\"feature-row__text\">\n\t\t\t\t\t<h3 class=\"feature-row__title\">Every page gets a clear job</h3>\n\t\t\t\t\t<p>We map the searches your buyers make to the pages that should win them, so you stop competing with yourself and fill the gaps.</p>\n\t\t\t\t\t<ul class=\"tick-list tick-list--plain\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Search volume and difficulty</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> One main keyword per page</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Gaps turned into new pages</li></ul>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"feature-row__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Keyword map · Service pages</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-scroll\"><table class=\"mock-table\"><thead><tr><th>Keyword</th><th class=\"num\">Volume</th><th>Difficulty</th><th>Target page</th></tr></thead><tbody><tr><td>dental implants cost</td><td class=\"num\">2,400</td><td><span class=\"mock-chip mock-chip--warn\">Medium</span></td><td>/dental-implants/</td></tr><tr><td>emergency dentist near me</td><td class=\"num\">6,600</td><td><span class=\"mock-chip mock-chip--bad\">High</span></td><td>/emergency-dentist/</td></tr><tr><td>invisalign price</td><td class=\"num\">1,900</td><td><span class=\"mock-chip mock-chip--ok\">Low</span></td><td>/invisalign/</td></tr><tr><td>teeth whitening clinic</td><td class=\"num\">1,300</td><td><span class=\"mock-chip mock-chip--ok\">Low</span></td><td>/teeth-whitening/</td></tr><tr><td>dental check up cost</td><td class=\"num\">880</td><td><span class=\"mock-chip mock-chip--ok\">Low</span></td><td>/check-ups/</td></tr></tbody></table></div></div>\n</figure></div>\n\t\t\t</div>\n\t\t\t<div class=\"feature-row\">\n\t\t\t\t<div class=\"feature-row__text\">\n\t\t\t\t\t<h3 class=\"feature-row__title\">Results people want to click</h3>\n\t\t\t\t\t<p>Better titles, descriptions and content make your result stand out and match what the searcher wants.</p>\n\t\t\t\t\t<ul class=\"tick-list tick-list--plain\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Titles and meta descriptions</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Content that answers the search</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Structured data for rich results</li></ul>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"feature-row__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Google search · Result preview</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-search\"/></svg>dental implants cost</div><div class=\"mock-serp mock-serp--win\"><span class=\"mock-serp__label\"><span class=\"mock-chip mock-chip--info\">Your page · #3, up from #24</span></span><div class=\"mock-serp__site\"><i>Y</i><span>Your Clinic · yourclinic.com › dental-implants</span></div><div class=\"mock-serp__title\">Dental Implants Cost in 2026: Prices, Finance and FAQs</div><div class=\"mock-serp__desc\">See clear prices for single and full-arch implants, what affects the cost, and finance options. Free consultation.</div></div><div class=\"mock-serp\"><div class=\"mock-serp__site\"><i>C</i><span>Competitor · competitor.com › implants</span></div><div class=\"mock-serp__title\">Dental implants | Competitor Dental</div><div class=\"mock-serp__desc\">Find out more about our dental implant treatments and book an appointment.</div></div></div>\n</figure></div>\n\t\t\t</div>\n\t\t\t<div class=\"feature-row feature-row--flip\">\n\t\t\t\t<div class=\"feature-row__text\">\n\t\t\t\t\t<h3 class=\"feature-row__title\">Progress you can see every week</h3>\n\t\t\t\t\t<p>We track your target keywords weekly and report the movement, so you always know what’s working.</p>\n\t\t\t\t\t<ul class=\"tick-list tick-list--plain\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Weekly rank tracking</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Monthly report in plain language</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Next steps agreed each month</li></ul>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"feature-row__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Rank tracking · Weekly</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-scroll\"><table class=\"mock-table\"><thead><tr><th>Keyword</th><th class=\"num\">Before</th><th class=\"num\">Now</th><th class=\"num\">Change</th></tr></thead><tbody><tr><td>dental implants cost</td><td class=\"num\"><span class=\"mock-pos\">24</span></td><td class=\"num\"><span class=\"mock-pos mock-pos--top\">3</span></td><td class=\"num\"><span class=\"mock-up\">▲ 21</span></td></tr><tr><td>invisalign price</td><td class=\"num\"><span class=\"mock-pos\">18</span></td><td class=\"num\"><span class=\"mock-pos mock-pos--top\">2</span></td><td class=\"num\"><span class=\"mock-up\">▲ 16</span></td></tr><tr><td>teeth whitening clinic</td><td class=\"num\"><span class=\"mock-pos\">31</span></td><td class=\"num\"><span class=\"mock-pos\">5</span></td><td class=\"num\"><span class=\"mock-up\">▲ 26</span></td></tr><tr><td>emergency dentist near me</td><td class=\"num\"><span class=\"mock-pos\">42</span></td><td class=\"num\"><span class=\"mock-pos\">9</span></td><td class=\"num\"><span class=\"mock-up\">▲ 33</span></td></tr><tr><td>dental check up cost</td><td class=\"num\"><span class=\"mock-pos\">15</span></td><td class=\"num\"><span class=\"mock-pos mock-pos--top\">1</span></td><td class=\"num\"><span class=\"mock-up\">▲ 14</span></td></tr></tbody></table></div></div>\n</figure></div>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
