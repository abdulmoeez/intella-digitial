  {
   "name": "intella/faq",
   "attrs": {
    "background": "cream",
    "anchor": "",
    "title": "SEO questions, <em>answered</em>",
    "lead": "Can’t find your answer? Ask us on a free 30-minute call.",
    "buttonText": "Contact us",
    "buttonUrl": "/contact/",
    "items": [
     {
      "question": "How long does SEO take to work?",
      "answer": "SEO builds over time. Technical fixes and page improvements can show early movement, while competitive rankings usually take a few months. We agree realistic milestones in your plan and report on them every month."
     },
     {
      "question": "Do you guarantee page 1 rankings?",
      "answer": "No one can honestly guarantee rankings, because search engines decide them. What we can promise is a clear plan, steady work on the things that move rankings, and transparent reporting on the results."
     },
     {
      "question": "Can you do SEO on our existing website?",
      "answer": "Yes. We work with most platforms, including WordPress, Shopify and custom sites. If something can’t be fixed on your current setup, we’ll explain why and suggest options."
     },
     {
      "question": "What is the difference between SEO and GEO?",
      "answer": "SEO helps you rank in search results. GEO helps you get mentioned in AI answers from tools like ChatGPT and Google’s AI Overviews. They share a lot of groundwork, so we usually plan them together."
     },
     {
      "question": "How much do your SEO services cost?",
      "answer": "It depends on your goals and how competitive your market is. After a free call we send a clear monthly fee, so you know the cost before any work starts."
     }
    ],
    "buttonStyle": "outline"
   }
  },
