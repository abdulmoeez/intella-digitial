  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "What finance SEO needs to rank",
    "html": "<section class=\"section section--white\" aria-labelledby=\"h-57\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-57\">What finance SEO <span class=\"accent\">needs to rank</span></h2>\n\t\t\t\t<p class=\"section-lead\">Money topics are judged more strictly than most. These four things make the difference.</p>\n\t\t\t</div>\n\t\t\t<ul class=\"tilt-grid tilt-grid--4\" role=\"list\">\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-user\"/></svg></span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Real expertise</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">Content written or reviewed by qualified people, with their credentials shown.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg></span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Trust signals</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">Clear company details, regulation, reviews and transparent pricing.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-pen\"/></svg></span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Accurate content</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">Up-to-date rates, rules and examples, checked before and after publishing.</p>\n\t\t\t\t</li>\n\t\t\t\t<li class=\"tilt-card\">\n\t\t\t\t\t<span class=\"icon-tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-link\"/></svg></span>\n\t\t\t\t\t<h3 class=\"tilt-card__title\">Authority</h3>\n\t\t\t\t\t<p class=\"tilt-card__text\">Mentions and links from respected finance and business publications.</p>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t</section>",
    "css": "financial-services-seo",
    "modules": []
   }
