   "name": "intella/custom-section",
   "attrs": {
    "label": "Financial services SEO that builds trust and leads",
    "html": "<section class=\"page-hero page-hero--center hero-wide\" aria-labelledby=\"page-title\">\n\t\t<div class=\"container\">\n\t\t\t<nav class=\"breadcrumb\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/\">Home</a></li><li><a href=\"/services/\">Services</a></li><li><a href=\"/services/digital-marketing/seo/\">SEO</a></li><li aria-current=\"page\">Financial Services SEO</li></ol></nav>\n\t\t\t<h1 class=\"page-hero__title\" id=\"page-title\">Financial services SEO that builds <span class=\"accent\">trust and leads</span></h1>\n\t\t\t<p class=\"page-hero__lead\">Finance is one of the hardest markets to rank in. Google wants proof of expertise and trust. We build content and pages that show both, reviewed with your compliance team before anything goes live.</p>\n\t\t\t<div class=\"hero__actions hero__actions--center\">\n\t\t\t\t<a class=\"button button--primary button--lg\" href=\"#proposal\">Request a proposal <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t<a class=\"button button--outline button--lg\" href=\"#process-title\">See how we work</a>\n\t\t\t</div>\n\t\t\t<ul class=\"chip-row chip-row--plain\" role=\"list\"><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Content written by finance specialists</span></li><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Compliance review built into every page</span></li><li><span class=\"chip chip--static\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Leads tracked from search to sign-up</span></li></ul>\n\t\t\t<div class=\"hero-wide__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Search visibility · Example</span></div>\n\t<div class=\"mock__body\"><div class=\"mk-two\"><div><div class=\"mock-stats\"><div class=\"mock-stat mock-stat--violet\"><div class=\"mock-stat__label\">Top-10 keywords</div><div class=\"mock-stat__value\">286</div><span class=\"mock-up\">▲ +142</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Organic leads</div><div class=\"mock-stat__value\">418</div><span class=\"mock-up\">▲ +96%</span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Pages reviewed by experts</div><div class=\"mock-stat__value\">100%</div><span class=\"mock-up\">▲ </span></div><div class=\"mock-stat\"><div class=\"mock-stat__label\">Avg. position</div><div class=\"mock-stat__value\">6.2</div><span class=\"mock-up\">▲ from 14.8</span></div></div></div><div><p class=\"mock__heading\">Top pages from search</p><div class=\"mock-scroll\"><table class=\"mock-table\"><thead><tr><th>Page</th><th class=\"num\">Leads</th></tr></thead><tbody><tr><td>/business-loans/</td><td class=\"num\">96</td></tr><tr><td>/guides/cash-flow-forecast/</td><td class=\"num\">74</td></tr><tr><td>/accounting-for-startups/</td><td class=\"num\">58</td></tr><tr><td>/compare/savings-accounts/</td><td class=\"num\">41</td></tr></tbody></table></div></div></div></div>\n</figure></div>\n\t\t</div>\n\t</section>",
    "css": "financial-services-seo",
    "modules": []
   }
