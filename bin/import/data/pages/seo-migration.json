  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "What a website migration can cost you",
    "html": "<section class=\"section section--white\" aria-labelledby=\"h-39\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"section-head section-head--center\">\n\t\t\t\t<h2 class=\"section-title\" id=\"h-39\">What a website migration <span class=\"accent\">can cost you</span></h2>\n\t\t\t\t<p class=\"section-lead\">Most traffic drops after a migration are avoidable.</p>\n\t\t\t</div>\n\t\t\t<div class=\"ba\">\n\t\t\t\t<div class=\"ba__col ba__col--before\"><span class=\"ba__tag\">Migration without SEO</span><ul role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Old URLs return 404 errors</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Rankings drop for pages that moved</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Links from other sites point to nowhere</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg> Tracking stops working on launch day</li></ul></div>\n\t\t\t\t<span class=\"ba__arrow\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></span>\n\t\t\t\t<div class=\"ba__col ba__col--after\"><span class=\"ba__tag\">Migration with SEO</span><ul role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Every old URL redirects to the right new page</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Rankings carry over to the new pages</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Link authority is kept</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Analytics and conversions tracked from day one</li></ul></div>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "seo-migration",
    "modules": []
   }
  },
  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "Every URL, mapped by hand",
    "html": "<section class=\"section section--white\" aria-labelledby=\"h-40\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"dark-split\">\n\t\t\t\t<div class=\"dark-split__text\">\n\t\t\t\t\t<h2 class=\"dark-split__title\" id=\"h-40\">Every URL, <span class=\"accent accent--light\">mapped by hand</span></h2>\n\t\t\t\t\t<p>Automatic redirects send too many pages to the homepage. We map each old URL to its closest new page, so visitors and rankings land in the right place.</p>\n\t\t\t\t\t<ul class=\"tick-list tick-list--plain\" role=\"list\"><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Full crawl of the old site</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> One-to-one redirect map</li><li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Redirects tested before launch</li></ul>\n\t\t\t\t\t<a class=\"button button--light\" href=\"#proposal\">Plan my migration <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"dark-split__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Redirect map · 1,284 URLs</span></div>\n\t<div class=\"mock__body\"><div class=\"mock-scroll\"><table class=\"mock-table\"><thead><tr><th>Old URL</th><th>New URL</th><th>Status</th></tr></thead><tbody><tr><td>/services.php?id=12</td><td>/services/seo/</td><td><span class=\"mock-chip mock-chip--ok\">301</span></td></tr><tr><td>/blog/2019/05/seo-tips</td><td>/articles/seo-tips/</td><td><span class=\"mock-chip mock-chip--ok\">301</span></td></tr><tr><td>/about-us.html</td><td>/about/</td><td><span class=\"mock-chip mock-chip--ok\">301</span></td></tr><tr><td>/old-landing</td><td>/services/</td><td><span class=\"mock-chip mock-chip--ok\">301</span></td></tr><tr><td>/products/item-445</td><td>/shop/linen-shirt/</td><td><span class=\"mock-chip mock-chip--ok\">301</span></td></tr></tbody></table></div></div>\n</figure></div>\n\t\t\t</div>\n\t\t</div>\n\t</section>",
    "css": "seo-migration",
    "modules": []
   }
