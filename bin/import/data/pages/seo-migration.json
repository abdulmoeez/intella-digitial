 "blocks": [
  {
   "name": "intella/custom-section",
   "attrs": {
    "label": "SEO migration services that protect your rankings",
    "html": "<section class=\"page-hero\" aria-labelledby=\"page-title\">\n\t\t<div class=\"container page-hero__inner\">\n\t\t\t<div>\n\t\t\t\t<nav class=\"breadcrumb\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/\">Home</a></li><li><a href=\"/services/\">Services</a></li><li><a href=\"/services/digital-marketing/seo/\">SEO</a></li><li aria-current=\"page\">SEO Migration</li></ol></nav>\n\t\t\t\t<h1 class=\"page-hero__title\" id=\"page-title\">SEO migration services that <span class=\"accent\">protect your rankings</span></h1>\n\t\t\t\t<p class=\"page-hero__lead\">A new website, platform or domain can wipe out years of rankings overnight. We plan every redirect, test before launch and watch closely afterwards, so your traffic moves with you.</p>\n\t\t\t\t<ul class=\"note-list\" role=\"list\">\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Every URL mapped and redirected</li>\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Pre-launch checks on staging</li>\n\t\t\t\t\t<li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg> Daily monitoring after launch</li>\n\t\t\t\t</ul>\n\t\t\t\t<div class=\"hero__actions\">\n\t\t\t\t\t<a class=\"button button--primary button--lg\" href=\"#proposal\">Request a proposal <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-arrow-right\"/></svg></a>\n\t\t\t\t\t<a class=\"button button--outline button--lg\" href=\"#process-title\">See the checklist</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"page-hero__visual\"><figure class=\"mock\">\n\t<div class=\"mock__bar\"><span class=\"mock__dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span class=\"mock__title\">Organic traffic · Before and after migration</span></div>\n\t<div class=\"mock__body\"><svg class=\"mock-chart\" viewBox=\"0 0 640 190\" role=\"img\" aria-label=\"Organic traffic held steady through launch, then grew\"><defs><linearGradient id=\"g30490\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#8f2cf4\" stop-opacity=\"0.28\"/><stop offset=\"1\" stop-color=\"#8f2cf4\" stop-opacity=\"0\"/></linearGradient></defs><line x1=\"16\" x2=\"622\" y1=\"12.0\" y2=\"12.0\" stroke=\"#efeaf2\"/><line x1=\"16\" x2=\"622\" y1=\"50.0\" y2=\"50.0\" stroke=\"#efeaf2\"/><line x1=\"16\" x2=\"622\" y1=\"88.0\" y2=\"88.0\" stroke=\"#efeaf2\"/><line x1=\"16\" x2=\"622\" y1=\"126.0\" y2=\"126.0\" stroke=\"#efeaf2\"/><line x1=\"16\" x2=\"622\" y1=\"164.0\" y2=\"164.0\" stroke=\"#efeaf2\"/><path d=\"M16.0,66.0 L71.1,61.3 L126.2,63.6 L181.3,59.4 L236.4,56.6 L291.5,58.5 L346.5,60.8 L401.6,54.8 L456.7,48.2 L511.8,42.2 L566.9,33.8 L622.0,25.8 L622.0,164 L16.0,164 Z\" fill=\"url(#g30490)\"/><path d=\"M16.0,66.0 L71.1,61.3 L126.2,63.6 L181.3,59.4 L236.4,56.6 L291.5,58.5 L346.5,60.8 L401.6,54.8 L456.7,48.2 L511.8,42.2 L566.9,33.8 L622.0,25.8\" fill=\"none\" stroke=\"#8f2cf4\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><circle cx=\"622.0\" cy=\"25.8\" r=\"4\" fill=\"#fff\" stroke=\"#8f2cf4\" stroke-width=\"2.5\"/><text x=\"16.0\" y=\"184\" text-anchor=\"middle\">W-6</text><text x=\"126.2\" y=\"184\" text-anchor=\"middle\">W-4</text><text x=\"236.4\" y=\"184\" text-anchor=\"middle\">W-2</text><text x=\"346.5\" y=\"184\" text-anchor=\"middle\">Live</text><text x=\"456.7\" y=\"184\" text-anchor=\"middle\">W+2</text><text x=\"566.9\" y=\"184\" text-anchor=\"middle\">W+4</text><text x=\"622.0\" y=\"184\" text-anchor=\"middle\">W+5</text></svg><div class=\"mock-legend\"><span><i style=\"background:#8f2cf4\"></i>Organic sessions</span></div><p class=\"mock-note\" style=\"text-align:left;margin-top:.5rem\">Launch week marked “Live”.</p></div>\n</figure></div>\n\t\t</div>\n\t</section>",
    "css": "seo-migration",
    "modules": []
