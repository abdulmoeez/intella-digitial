{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "48rem",
			"wideSize": "75rem"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "ink", "name": "Ink (placeholder)", "color": "#0e0a1a" },
				{ "slug": "paper", "name": "Paper (placeholder)", "color": "#ffffff" },
				{ "slug": "mist", "name": "Mist (placeholder)", "color": "#f1eff7" },
				{ "slug": "accent", "name": "Accent (placeholder)", "color": "#9b30ff" },
				{ "slug": "accent-dark", "name": "Accent dark (placeholder)", "color": "#2a0f4d" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{ "slug": "body", "name": "Body (placeholder)", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" },
				{ "slug": "heading", "name": "Heading (placeholder)", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "rem", "%", "px" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 8vw, 6rem)" }
			]
		}
	}
}
