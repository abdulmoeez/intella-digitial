{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "intella/service-lines",
	"title": "All services (side tabs)",
	"category": "intella",
	"icon": "list-view",
	"description": "One tab per service line with example screens and its services.",
	"supports": {
		"html": false
	},
	"render": "file:./render.php",
	"style": "file:./style.css",
	"viewScriptModule": [
		"@intella/tabs",
		"@intella/carousels"
	],
	"intella": {
		"fields": [
			{
				"key": "title",
				"type": "inline",
				"label": "Heading"
			},
			{
				"key": "tabs",
				"type": "repeater",
				"label": "Service lines",
				"itemName": "service line",
				"itemLabel": "tab",
				"panel": "Service lines",
				"fields": [
					{
						"key": "key",
						"type": "text",
						"label": "Anchor",
						"help": "e.g. seo, so /services/#seo opens this tab"
					},
					{
						"key": "tab",
						"type": "text",
						"label": "Tab title"
					},
					{
						"key": "sub",
						"type": "text",
						"label": "Tab subtitle"
					},
					{
						"key": "title",
						"type": "inline",
						"label": "Heading"
					},
					{
						"key": "lead",
						"type": "textarea",
						"label": "Intro"
					},
					{
						"key": "text",
						"type": "textarea",
						"label": "Text"
					},
					{
						"key": "slides",
						"type": "repeater",
						"label": "Example screens",
						"itemName": "slide",
						"fields": [
							{
								"key": "main",
								"type": "code",
								"label": "Screen"
							},
							{
								"key": "alt",
								"type": "code",
								"label": "Second screen"
							}
						],
						"default": []
					},
					{
						"key": "links",
						"type": "repeater",
						"label": "Services",
						"itemName": "service",
						"fields": [
							{
								"key": "title",
								"type": "text",
								"label": "Name"
							},
							{
								"key": "description",
								"type": "text",
								"label": "Description"
							},
							{
								"key": "url",
								"type": "url",
								"label": "Link"
							},
							{
								"key": "tool",
								"type": "text",
								"label": "Tool logo"
							}
						],
						"default": []
					},
					{
						"key": "ctaText",
						"type": "text",
						"label": "Button text"
					},
					{
						"key": "ctaUrl",
						"type": "url",
						"label": "Button link"
					}
				],
				"default": []
			}
		],
		"section": "white"
	}
}
