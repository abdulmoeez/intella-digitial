{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "intella/trust-grid",
	"title": "Trust points",
	"category": "intella",
	"icon": "shield",
	"description": "Heading and a grid of short trust points with icons.",
	"supports": {
		"html": false
	},
	"render": "file:./render.php",
	"style": "file:./style.css",
	"intella": {
		"fields": [
			{
				"key": "title",
				"type": "inline",
				"label": "Heading"
			},
			{
				"key": "lead",
				"type": "inline",
				"label": "Intro"
			},
			{
				"key": "items",
				"type": "repeater",
				"label": "Points",
				"itemName": "point",
				"fields": [
					{
						"key": "icon",
						"type": "text",
						"label": "Icon"
					},
					{
						"key": "title",
						"type": "text",
						"label": "Title"
					},
					{
						"key": "text",
						"type": "textarea",
						"label": "Text"
					}
				],
				"default": []
			}
		],
		"section": "cream"
	}
}
